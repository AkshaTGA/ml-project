# --- LLM provider (pick ONE block) ---
#
# Option A: NVIDIA NIM  (set NVIDIA_API_KEY; xAI keys are ignored when this is present)
NVIDIA_API_KEY=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
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b        # default
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # default

# Option B: xAI Grok (default when NVIDIA_API_KEY is not set)
LLM_API_KEY=your-xai-api-key
# Main model: answers, tool decisions, vision.
LLM_MODEL=grok-4.7
# Fast model for background memory work (titles, summaries, fact extraction)
LLM_FAST_MODEL=grok-4.20-non-reasoning
LLM_TEMPERATURE=0.3
# Set to false if the model can't read images
LLM_VISION=true

# --- Database: Postgres with pgvector (Neon / Supabase) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Frontend origins allowed to use session tokens (comma-separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# --- Voice (Sarvam AI) ---
SARVAM_API_KEY=

# --- Deployed model APIs (full prediction endpoint URLs; empty = mock response) ---
BIOMASS_API_URL=
# Multipart field name the biomass API reads the image from
BIOMASS_IMAGE_FIELD=image
CROP_API_URL=
LIVESTOCK_API_URL=

# --- Optional ---
# Live mandi prices from data.gov.in (falls back to web search when empty)
DATA_GOV_IN_API_KEY=
# Better web search results (falls back to DuckDuckGo when empty)
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173
