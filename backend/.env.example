# --- LLM provider ---
# Choose explicitly with LLM_PROVIDER=gemini|nvidia|muse|xai.
# If unset, the first provider with a key wins: gemini -> nvidia -> muse -> xai.
LLM_PROVIDER=

# Option A: Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash

# Option B: NVIDIA NIM
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Option C: Meta Muse (Meta Model API, https://dev.meta.ai). MODEL_API_KEY also works.
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_FAST_MODEL=muse-ember-1.0
# Muse models always reason: minimal | low | medium | high | xhigh | max (lower = faster answers)
MUSE_REASONING_EFFORT=medium
MUSE_FAST_REASONING_EFFORT=low

# Option D: xAI Grok
LLM_API_KEY=your-xai-api-key
# Main model: answers, tool decisions, vision.
LLM_MODEL=grok-4.7
# Fast model for background memory work (titles, summaries, fact extraction)
LLM_FAST_MODEL=grok-4.20-non-reasoning
LLM_TEMPERATURE=0.3
# Set to false if the model can't read images
LLM_VISION=true

# --- Database: Postgres with pgvector (Neon / Supabase) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Auth (Clerk) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Frontend origins allowed to use session tokens (comma-separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# --- Voice (Sarvam AI) ---
SARVAM_API_KEY=

# --- Deployed model APIs (empty = mock response) ---
# Biomass ML service base URL. Each measurement is POST {BIOMASS_API_URL}/targets/{slug}/predict.
BIOMASS_API_URL=http://127.0.0.1:8100
# Multipart field name the biomass API reads the image from
BIOMASS_IMAGE_FIELD=image
CROP_API_URL=
LIVESTOCK_API_URL=

# --- Optional ---
# Live mandi prices from data.gov.in (falls back to web search when empty)
DATA_GOV_IN_API_KEY=
# Better web search results (falls back to DuckDuckGo when empty)
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173
